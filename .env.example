# PantryPilot MCP — no AWS keys required for MVP
PORT=3000
HOST=127.0.0.1
# Public base URL clients use (optional; defaults to http://HOST:PORT)
# MCP_PUBLIC_URL=http://127.0.0.1:3000
# Comma-separated Host header allow-list when binding beyond localhost
# ALLOWED_HOSTS=localhost,127.0.0.1,pantrypilot.local
