# PantryPilot MCP — AWS keys optional (stub meal_plan without them)
PORT=3000
HOST=127.0.0.1
# Public base URL clients use (optional; defaults to http://HOST:PORT)
# MCP_PUBLIC_URL=http://127.0.0.1:3000
# Comma-separated Host header allow-list when binding beyond localhost
# ALLOWED_HOSTS=localhost,127.0.0.1,pantrypilot.local

# --- Optional Amazon Bedrock meal_plan path ---
# Both AWS_REGION and BEDROCK_MODEL_ID must be set to enable Bedrock.
# Credentials: use the standard AWS SDK chain (env keys, shared config, IAM role, etc.).
# Do NOT commit real secrets — copy this file to .env locally.
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
