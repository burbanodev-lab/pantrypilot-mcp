{
  "name": "pantrypilot-mcp",
  "version": "0.1.0",
  "description": "PantryPilot MCP server for Amazon Developer Hackathon Alexa+ track — household pantry, meal planning, and mock shopping cart tools over Streamable HTTP.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "smoke": "tsx scripts/mcp-smoke.ts",
    "dev": "tsx src/server.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "alexa",
    "pantry",
    "hackathon"
  ],
  "author": "Samuel Burbano",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1129.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.12.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
