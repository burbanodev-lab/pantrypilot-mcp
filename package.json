{
  "name": "pantrypilot-mcp",
  "version": "0.1.0",
  "description": "PantryPilot MCP \u2014 Alexa+ kitchen agent over Streamable HTTP (MCP 2025-11-25): kitchen_run, SQLite memory, media cards, optional Bedrock Converse, companion UI.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "smoke": "tsx scripts/mcp-smoke.ts",
    "mcp-conformance": "tsx scripts/mcp-conformance.ts",
    "judge-check": "tsx scripts/judge-check.ts",
    "submission-audit": "tsx scripts/submission-audit.ts",
    "alexa-addon-check": "node scripts/alexa-addon-check.mjs",
    "verify-submission": "npm run build && npm run submission-audit && npm run alexa-addon-check && npm run mcp-conformance && npm run smoke && npm run judge-check && npm run eval",
    "demo": "tsx scripts/demo-flow.ts",
    "dev": "tsx src/server.ts",
    "eval": "tsx evals/run.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "alexa",
    "pantry",
    "hackathon"
  ],
  "author": "Samuel Burbano",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1129.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "sql.js": "^1.14.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.12.0",
    "@types/sql.js": "^1.4.11",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
